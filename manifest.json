{
  "manifest_version": 3,
  "name": "Humble Torrent Grabber",
  "version": "1.0",
  "description": "Grab selected Humble Bundle torrents and send them to qBittorrent",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.humblebundle.com/*"],
      "js": ["content.js"]
    }
  ]
}
